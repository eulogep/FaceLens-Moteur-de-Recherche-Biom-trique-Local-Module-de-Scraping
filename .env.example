# Générer une valeur unique, par exemple : openssl rand -hex 32
FACELENS_API_KEY=replace-with-a-unique-64-character-secret-before-starting

# La valeur côté Vite est destinée uniquement à une utilisation locale, car toute
# variable VITE_* est intégrée au navigateur. Ne pas exposer cette interface sur Internet.
VITE_FACELENS_API_KEY=replace-with-the-same-local-secret
VITE_API_URL=http://localhost:8000
VITE_SEARXNG_URL=http://localhost:8080

# Autoriser uniquement les origines locales nécessaires, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limites de ressources et comportement de collecte.
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_REMOTE_IMAGE_BYTES=10485760
STRICT_REMOTE_URL_VALIDATION=true
